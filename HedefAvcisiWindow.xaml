<Window x:Class="PsikologTestApp.HedefAvcisiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Hedef Avcısı Testi" 
        WindowStyle="None"
        WindowState="Maximized"
        Background="Black"
        Foreground="White"
        KeyDown="Window_KeyDown">
    <Grid>
        <!-- Üst Bar -->
        <Border VerticalAlignment="Top" 
                Background="#1a1a1a"
                Padding="20"
                Height="80">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Hedef Avcısı Testi" 
                       FontSize="24" 
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,40,0"/>
            
            <TextBlock Text="Aranan Harf: " 
                       FontSize="18"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            
            <TextBlock x:Name="TargetLetterDisplay" 
                       Text="?" 
                       FontSize="36" 
                       FontWeight="Bold"
                       Foreground="#4CAF50"
                       VerticalAlignment="Center"
                       MinWidth="60"
                       TextAlignment="Center"
                       Margin="0,0,60,0"/>
            
            <TextBlock Text="Kalan Süre: " 
                       FontSize="18"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            
            <TextBlock x:Name="TimeDisplay" 
                       Text="05:00" 
                       FontSize="28" 
                       FontWeight="Bold"
                       Foreground="#FF9800"
                       VerticalAlignment="Center"
                       MinWidth="120"
                       TextAlignment="Center"/>
        </StackPanel>
        </Border>

        <!-- Ana Test Alanı -->
        <Grid VerticalAlignment="Stretch">
            <TextBlock x:Name="DisplayedLetterBlock" 
                       Text="?" 
                       FontSize="360" 
                       FontWeight="Bold"
                       Foreground="White"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Opacity="0.8"/>
        </Grid>

        <!-- Alt Bilgi Paneli -->
        <Border VerticalAlignment="Bottom" 
                HorizontalAlignment="Stretch"
                Background="#1a1a1a"
                Padding="20">
            <StackPanel Orientation="Vertical"
                       HorizontalAlignment="Center">
                <TextBlock Text="Aranan harfin rengi değişince SPACE'e basınız" 
                           FontSize="16"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                
                <TextBlock x:Name="HintBlock" 
                           Text="Teste başlamak için herhangi bir tuşa basınız" 
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Foreground="#FFEB3B"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
