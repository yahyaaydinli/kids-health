<Window x:Class="PsikologTestApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Psikoloji Test Uygulaması" Height="840" Width="800" 
        MinWidth="360" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,30,0,30">
            <TextBlock Text="Psikoloji Test Uygulaması" 
                       FontSize="32" 
                       FontWeight="Bold" 
                       Foreground="#333333"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>
            
            <TextBlock Text="Lütfen başlamak istediğiniz testi seçin:" 
                       FontSize="16" 
                       Foreground="#666666"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>
            
            <Button x:Name="HedefAvcisiButton" 
                    Click="HedefAvcisiButton_Click"
                    Content="🎯 Hedef Avcısı Testi" 
                    Padding="20,15" 
                    FontSize="16"
                    Background="#4CAF50" 
                    Foreground="White"
                    Cursor="Hand"
                    Width="300"
                    Height="60"
                    Margin="0,0,0,8"/>

            <TextBlock Text="Reaksiyon hızınızı ölçün"
                       FontSize="12"
                       Foreground="#999999"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24"/>

            <Button x:Name="RenkliKelimelerButton"
                    Click="RenkliKelimelerButton_Click"
                    Content="🎨 Renkli Kelimeler Testi"
                    Padding="20,15"
                    FontSize="16"
                    Background="#9C27B0"
                    Foreground="White"
                    Cursor="Hand"
                    Width="300"
                    Height="60"
                    Margin="0,0,0,8"/>

            <TextBlock Text="Stroop testi — renk algısı ve dikkat"
                       FontSize="12"
                       Foreground="#999999"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24"/>

            <Button x:Name="YuruYurumeButton"
                    Click="YuruYurumeButton_Click"
                    Content="🚦 Yürü ve Yürüme Testi"
                    Padding="20,15"
                    FontSize="16"
                    Background="#00897B"
                    Foreground="White"
                    Cursor="Hand"
                    Width="300"
                    Height="60"
                    Margin="0,0,0,8"/>

            <TextBlock Text="Go/No-Go — dürtü kontrolü ve tepki inhibisyonu"
                       FontSize="12"
                       Foreground="#999999"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24"/>

            <Button x:Name="DedektifButton"
                    Click="DedektifButton_Click"
                    Content="🔍 Dedektif Testi"
                    Padding="20,15"
                    FontSize="16"
                    Background="#1565C0"
                    Foreground="White"
                    Cursor="Hand"
                    Width="300"
                    Height="60"
                    Margin="0,0,0,8"/>

            <TextBlock Text="Figürler arasında hedefi bul — dikkat ve görsel arama"
                       FontSize="12"
                       Foreground="#999999"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24"/>

            <Button x:Name="AyakIziButton"
                    Click="AyakIziButton_Click"
                    Content="👣 Ayak İzi Testi"
                    Padding="20,15"
                    FontSize="16"
                    Background="#F4511E"
                    Foreground="White"
                    Cursor="Hand"
                    Width="300"
                    Height="60"
                    Margin="0,0,0,8"/>

            <TextBlock Text="Corsi blok testi — görsel-uzamsal çalışma belleği"
                       FontSize="12"
                       Foreground="#999999"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24"/>

            <Button x:Name="DogruHedefButton"
                    Click="DogruHedefButton_Click"
                    Content="🎯 Doğru Hedef Testi"
                    Padding="20,15"
                    FontSize="16"
                    Background="#AD1457"
                    Foreground="White"
                    Cursor="Hand"
                    Width="300"
                    Height="60"
                    Margin="0,0,0,8"/>

            <TextBlock Text="Sürekli Performans Testi — dikkat ve tepki seçimi"
                       FontSize="12"
                       Foreground="#999999"
                       HorizontalAlignment="Center"/>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
