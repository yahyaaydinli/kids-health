<Window x:Class="PsikologTestApp.Tests.AyakIzi.AyakIziStartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayak İzi Testi" Height="600" Width="600"
        MinWidth="400" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <!-- Kare seçim kartları için RadioButton stili -->
        <Style x:Key="GridSizeCard" TargetType="RadioButton">
            <Setter Property="GroupName"       Value="GridSize"/>
            <Setter Property="Width"           Value="112"/>
            <Setter Property="Height"          Value="90"/>
            <Setter Property="Margin"          Value="6"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background"  Value="#FBE9E7"/>
                                <Setter Property="BorderBrush" Value="#F4511E"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#F4511E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel HorizontalAlignment="Center" MaxWidth="540" Margin="20,30,20,30">

            <TextBlock Text="👣 Ayak İzi Testi"
                       FontSize="34" FontWeight="Bold" Foreground="#F4511E"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- Açıklama -->
            <Border Background="White" CornerRadius="8"
                    BorderBrush="#E0E0E0" BorderThickness="1"
                    Padding="20" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="#444" LineHeight="24">
                        Ekranda kareler belirir. Kareler <Bold>sırayla ışıklanır</Bold>.
                        Sırayı <Bold>ezberle</Bold> ve aynı sırayla karelere tıkla!
                    </TextBlock>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="14" Foreground="#444" LineHeight="24">
                        Her başarılı turda dizi <Bold>bir uzar</Bold>. Ne kadar uzun bir dizi hatırlayabilirsin?
                        Yanlış bir kareye basarsan test sona erer.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Kare Sayısı Seçimi -->
            <Border Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1"
                    Padding="20" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Izgara Boyutu Seçin:" FontSize="15" FontWeight="Bold"
                               Foreground="#333" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                        <RadioButton x:Name="Grid4Radio" Style="{StaticResource GridSizeCard}"
                                     Tag="4" IsChecked="True">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="4" FontSize="26" FontWeight="Bold"
                                           Foreground="#F4511E" HorizontalAlignment="Center"/>
                                <TextBlock Text="Kare" FontSize="12" Foreground="#666"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="(2×2)" FontSize="11" Foreground="#999"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="Grid9Radio" Style="{StaticResource GridSizeCard}" Tag="9">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="9" FontSize="26" FontWeight="Bold"
                                           Foreground="#F4511E" HorizontalAlignment="Center"/>
                                <TextBlock Text="Kare" FontSize="12" Foreground="#666"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="(3×3)" FontSize="11" Foreground="#999"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="Grid16Radio" Style="{StaticResource GridSizeCard}" Tag="16">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="16" FontSize="26" FontWeight="Bold"
                                           Foreground="#F4511E" HorizontalAlignment="Center"/>
                                <TextBlock Text="Kare" FontSize="12" Foreground="#666"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="(4×4)" FontSize="11" Foreground="#999"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="Grid25Radio" Style="{StaticResource GridSizeCard}" Tag="25">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="25" FontSize="26" FontWeight="Bold"
                                           Foreground="#F4511E" HorizontalAlignment="Center"/>
                                <TextBlock Text="Kare" FontSize="12" Foreground="#666"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="(5×5)" FontSize="11" Foreground="#999"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Geri Sayım Süresi -->
            <Border Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1"
                    Padding="20" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Geri Sayım Süresi (test öncesi):" FontSize="15" FontWeight="Bold"
                               Foreground="#333" Margin="0,0,0,8"/>
                    <Slider x:Name="CountdownSlider" Minimum="1" Maximum="5" Value="3"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            SmallChange="1" LargeChange="1"
                            ValueChanged="CountdownSlider_ValueChanged" Margin="0,0,0,4"/>
                    <Grid>
                        <TextBlock Text="1 sn" HorizontalAlignment="Left"  FontSize="11" Foreground="#999"/>
                        <TextBlock x:Name="CountdownLabel" Text="3 saniye"
                                   HorizontalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="#F4511E"/>
                        <TextBlock Text="5 sn" HorizontalAlignment="Right" FontSize="11" Foreground="#999"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Button Content="▶  Testi Başlat" Click="StartTest_Click"
                    Padding="20,12" FontSize="15" FontWeight="Bold"
                    Background="#F4511E" Foreground="White"
                    Cursor="Hand" Width="220" Height="52"
                    HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <Button Content="← Geri" Click="BackButton_Click"
                    Padding="15,8" FontSize="12"
                    Background="#666666" Foreground="White"
                    Cursor="Hand" Width="100" HorizontalAlignment="Center"/>

        </StackPanel>
    </ScrollViewer>
</Window>
