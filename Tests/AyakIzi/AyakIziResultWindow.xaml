<Window x:Class="PsikologTestApp.Tests.AyakIzi.AyakIziResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayak İzi Testi — Sonuçlar" Height="720" Width="760"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="20,20,20,0">
            <StackPanel HorizontalAlignment="Stretch">

                <TextBlock Text="Ayak İzi — Sonuçlar"
                           FontSize="32" FontWeight="Bold" Foreground="#333"
                           HorizontalAlignment="Center" Margin="0,0,0,18"/>

                <!-- Özet kutusu -->
                <Border Background="White" CornerRadius="10" Padding="24"
                        BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sol: genel bilgi -->
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Test Türü: "        FontSize="14" Foreground="#666" Width="160"/>
                                <TextBlock x:Name="TestNameBlock"    FontSize="14" Foreground="#333" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Test Tarihi: "      FontSize="14" Foreground="#666" Width="160"/>
                                <TextBlock x:Name="TestDateBlock"    FontSize="14" Foreground="#333" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Izgara Boyutu: "    FontSize="14" Foreground="#666" Width="160"/>
                                <TextBlock x:Name="GridSizeBlock"    FontSize="14" Foreground="#1565C0" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Maks. Dizi Uzunluğu: " FontSize="14" Foreground="#666" Width="160"/>
                                <TextBlock x:Name="MaxSpanBlock"    FontSize="14" Foreground="#F4511E" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Sağ: performans -->
                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="✅ Başarılı Tur: "     FontSize="14" Foreground="#666" Width="172"/>
                                <TextBlock x:Name="CorrectBlock"        FontSize="14" Foreground="#43A047" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="🔢 Toplam Tur: "        FontSize="14" Foreground="#666" Width="172"/>
                                <TextBlock x:Name="TotalBlock"          FontSize="14" Foreground="#333" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="🎯 Başarı Oranı: "      FontSize="14" Foreground="#666" Width="172"/>
                                <TextBlock x:Name="RateBlock"           FontSize="14" Foreground="#1565C0" FontWeight="Bold"/>
                            </StackPanel>

                            <Separator Margin="0,8" Background="#EEE"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="⏱ Ort. Tamamlama: "    FontSize="14" Foreground="#666" Width="172"/>
                                <TextBlock x:Name="AvgBlock"            FontSize="14" Foreground="#4CAF50" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄 Toplam Yeni Dizi: "  FontSize="14" Foreground="#666" Width="172"/>
                                <TextBlock x:Name="NewSeqTotalBlock"    FontSize="14" Foreground="#F4511E" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Timeline -->
                <TextBlock Text="Zaman Çizelgesi"
                           FontSize="18" FontWeight="Bold" Foreground="#333" Margin="0,0,0,8"/>
                <Border Background="White" CornerRadius="10"
                        BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,8" Padding="14,10">
                    <StackPanel>
                        <!-- Legend -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Rectangle Width="18" Height="12" Fill="#388E3C" RadiusX="2" RadiusY="2" Margin="0,0,4,0"/>
                            <TextBlock Text="Başarılı" FontSize="11" Foreground="#555" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <Rectangle Width="18" Height="12" Fill="#E53935" RadiusX="2" RadiusY="2" Margin="0,0,4,0"/>
                            <TextBlock Text="Başarısız" FontSize="11" Foreground="#555" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <Rectangle Width="18" Height="12" Fill="#B0BEC5" RadiusX="2" RadiusY="2" Margin="0,0,4,0"/>
                            <TextBlock Text="Boşluk / Yok" FontSize="11" Foreground="#555" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ItemsControl x:Name="TimelineRows"/>
                    </StackPanel>
                </Border>

                <!-- Ayrıntılı tur tablosu -->
                <TextBlock Text="Tur Detayları"
                           FontSize="18" FontWeight="Bold" Foreground="#333" Margin="0,0,0,8"/>
                <Border Background="White" CornerRadius="10"
                        BorderBrush="#DDD" BorderThickness="1"
                        Margin="0,0,0,24" Padding="0">
                    <DataGrid x:Name="RoundsGrid"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F7F7F7"
                              CanUserReorderColumns="False" CanUserResizeRows="False"
                              BorderThickness="0" RowHeight="34" FontSize="13">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#EEEEEE"/>
                                <Setter Property="Padding"    Value="12,8"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize"   Value="13"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding"         Value="12,6"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#"                  Binding="{Binding RoundNumber}"   Width="44"/>
                            <DataGridTextColumn Header="Dizi Uzunluğu"      Binding="{Binding SpanLen}"       Width="120"/>
                            <DataGridTextColumn Header="Tamamlama Süresi"   Binding="{Binding ResponseTime}"  Width="140"/>
                            <DataGridTextColumn Header="🔄 Yeni Dizi"        Binding="{Binding NewSeqCount}"   Width="100"/>
                            <DataGridTemplateColumn Header="Sonuç" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Sonuc}"
                                                   Foreground="{Binding SonucColor}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   VerticalAlignment="Center" Margin="12,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Alt butonlar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,12,0,16">
            <Button Content="🏠 Ana Sayfa"  Click="HomeButton_Click"
                    Padding="15,10" FontSize="14" Background="#4CAF50" Foreground="White"
                    Cursor="Hand" Width="150" Height="45" Margin="0,0,15,0"/>
            <Button Content="🔄 Tekrar Et"  Click="RetryButton_Click"
                    Padding="15,10" FontSize="14" Background="#F4511E" Foreground="White"
                    Cursor="Hand" Width="150" Height="45" Margin="0,0,15,0"/>
            <Button Content="❌ Çık"         Click="ExitButton_Click"
                    Padding="15,10" FontSize="14" Background="#F44336" Foreground="White"
                    Cursor="Hand" Width="150" Height="45"/>
        </StackPanel>
    </Grid>
</Window>
