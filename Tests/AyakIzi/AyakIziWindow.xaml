<Window x:Class="PsikologTestApp.Tests.AyakIzi.AyakIziWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayak İzi Testi" Height="720" Width="720"
        MinWidth="400" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#ECEFF1"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="66"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="54"/>
        </Grid.RowDefinitions>

        <!-- Üst bilgi çubuğu -->
        <Border Grid.Row="0" Background="#F4511E">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="Tur #" FontSize="14" Foreground="#FFCCBC" VerticalAlignment="Center"/>
                    <TextBlock x:Name="RoundBlock" Text="1" FontSize="20" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>

                <TextBlock Text="👣 Ayak İzi Testi" FontSize="20" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Dizi: " FontSize="14" Foreground="#FFCCBC" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SpanBlock" Text="1" FontSize="22" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button x:Name="YeniDiziButton" Content="🔄 Yeni Dizi" Click="YeniDiziButton_Click"
                            Padding="10,4" FontSize="13" FontWeight="Bold"
                            Background="#F9A825" Foreground="White"
                            Cursor="Hand" Height="36" BorderThickness="0" Margin="0,0,8,0"
                            Visibility="Collapsed"/>
                    <Button Content="⏹ Bitir" Click="EndTestButton_Click"
                            Padding="10,4" FontSize="13" FontWeight="Bold"
                            Background="#BF360C" Foreground="White"
                            Cursor="Hand" Height="36" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Izgara alanı -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
            <UniformGrid x:Name="BlockGrid"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </ScrollViewer>

        <!-- Uyarı banner (Grid Row 1 üstünde, otomatik kapanır) -->
        <Border x:Name="WarningBanner" Grid.Row="1" VerticalAlignment="Top"
                Background="#E53935" CornerRadius="0,0,8,8" Padding="16,10"
                Panel.ZIndex="5" Visibility="Collapsed">
            <TextBlock x:Name="WarningText" Text=""
                       FontSize="15" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Alt durum çubuğu -->
        <Border Grid.Row="2" Background="White" BorderBrush="#CFD8DC" BorderThickness="0,1,0,0">
            <TextBlock x:Name="InstructionText" Text="Hazırlanıyor..."
                       FontSize="16" FontWeight="Bold" Foreground="#546E7A"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- Geri sayım overlay -->
        <Grid x:Name="CountdownOverlay" Grid.RowSpan="3"
              Background="#F0F4511E" Panel.ZIndex="10">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="CountdownNumber" Text="3" FontSize="200" FontWeight="Black"
                           Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,-20"/>
                <TextBlock Text="Hazırın mı?" FontSize="28" Foreground="#FFCCBC"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Duraklat overlay -->
        <Grid x:Name="PauseOverlay" Grid.RowSpan="3"
              Background="#CC000000" Panel.ZIndex="20" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⏸ Test Duraklatıldı" FontSize="36" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                <TextBlock Text="Devam ederken dizi yeniden gösterilecektir."
                           FontSize="14" Foreground="#BBBBBB" HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="▶ Devam Et" Click="ResumeButton_Click"
                            Padding="20,12" FontSize="16" FontWeight="Bold"
                            Background="#43A047" Foreground="White"
                            Cursor="Hand" Width="180" Height="52" Margin="0,0,20,0"/>
                    <Button Content="⏹ Testi Bitir" Click="EndTestButton_Click"
                            Padding="20,12" FontSize="16" FontWeight="Bold"
                            Background="#E53935" Foreground="White"
                            Cursor="Hand" Width="180" Height="52"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
