<Window x:Class="PsikologTestApp.Tests.YuruYurume.YuruYurumeStartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Yürü ve Yürüme Testi - Başlat" Height="700" Width="620"
        MinWidth="400" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel HorizontalAlignment="Center" Width="520" Margin="20,30,20,30">

            <TextBlock Text="Yürü ve Yürüme Testi"
                       FontSize="34" FontWeight="Bold"
                       Foreground="#333333"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- Açıklama -->
            <Border Background="White" CornerRadius="10" Padding="20"
                    BorderBrush="#DDD" BorderThickness="1"
                    Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock FontSize="14" Foreground="#555" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,0,0,12">
                        <Run Text="Ekranda büyük bir daire belirecek."/>
                        <LineBreak/>
                        <Run FontWeight="Bold" Foreground="#43A047" Text="YEŞİL"/>
                        <Run Text=" görünce hızlıca "/>
                        <Run FontWeight="Bold" Text="SPACE"/>
                        <Run Text=" tuşuna basın."/>
                        <LineBreak/>
                        <Run FontWeight="Bold" Foreground="#E53935" Text="KIRMIZI"/>
                        <Run Text=" görünce "/>
                        <Run FontWeight="Bold" Text="BASMAYIN."/>
                    </TextBlock>

                    <!-- Mini önizleme -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,20,0">
                            <Ellipse Width="54" Height="54" Fill="#43A047" HorizontalAlignment="Center"/>
                            <TextBlock Text="BAS" FontSize="12" FontWeight="Bold"
                                       Foreground="#43A047" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <Ellipse Width="54" Height="54" Fill="#E53935" HorizontalAlignment="Center"/>
                            <TextBlock Text="BASMA" FontSize="12" FontWeight="Bold"
                                       Foreground="#E53935" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Yeşil (Bas) Oranı -->
            <TextBlock Text="Yeşil (Bas) Oranı:"
                       FontSize="15" Foreground="#333"
                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <StackPanel Margin="0,0,0,4">
                <Slider x:Name="GoPercentSlider"
                        Minimum="10" Maximum="90"
                        Value="70"
                        TickFrequency="10"
                        IsSnapToTickEnabled="True"
                        SmallChange="10" LargeChange="20"
                        ValueChanged="GoPercentSlider_ValueChanged"
                        Margin="0,0,0,4"/>
                <Grid>
                    <TextBlock Text="10%" HorizontalAlignment="Left"  FontSize="11" Foreground="#999"/>
                    <TextBlock x:Name="GoPercentLabel"
                               Text="70%"
                               HorizontalAlignment="Center"
                               FontSize="14" FontWeight="Bold" Foreground="#43A047"/>
                    <TextBlock Text="90%" HorizontalAlignment="Right" FontSize="11" Foreground="#999"/>
                </Grid>
            </StackPanel>
            <TextBlock x:Name="GoRatioHintLabel"
                       Text="(Yeşil: %70  —  Kırmızı: %30)"
                       FontSize="12" Foreground="#888"
                       HorizontalAlignment="Center" Margin="0,0,0,16"/>

            <!-- Uyaran Gösterim Süresi -->
            <TextBlock Text="Uyaran Gösterim Süresi (ms):"
                       FontSize="15" Foreground="#333"
                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <StackPanel Margin="0,0,0,4">
                <Slider x:Name="DisplayIntervalSlider"
                        Minimum="300" Maximum="2000"
                        Value="800"
                        TickFrequency="100"
                        IsSnapToTickEnabled="True"
                        SmallChange="100" LargeChange="300"
                        ValueChanged="DisplayIntervalSlider_ValueChanged"
                        Margin="0,0,0,4"/>
                <Grid>
                    <TextBlock Text="300 ms" HorizontalAlignment="Left"  FontSize="11" Foreground="#999"/>
                    <TextBlock x:Name="DisplayIntervalLabel"
                               Text="800 ms"
                               HorizontalAlignment="Center"
                               FontSize="14" FontWeight="Bold" Foreground="#2196F3"/>
                    <TextBlock Text="2000 ms" HorizontalAlignment="Right" FontSize="11" Foreground="#999"/>
                </Grid>
            </StackPanel>

            <!-- Harfler Arası Bekleme -->
            <TextBlock Text="Uyaranlar Arası Bekleme (ms):"
                       FontSize="15" Foreground="#333"
                       HorizontalAlignment="Center" Margin="0,16,0,4"/>
            <StackPanel Margin="0,0,0,4">
                <Slider x:Name="GapIntervalSlider"
                        Minimum="0" Maximum="1500"
                        Value="400"
                        TickFrequency="100"
                        IsSnapToTickEnabled="True"
                        SmallChange="100" LargeChange="300"
                        ValueChanged="GapIntervalSlider_ValueChanged"
                        Margin="0,0,0,4"/>
                <Grid>
                    <TextBlock Text="0 ms"    HorizontalAlignment="Left"  FontSize="11" Foreground="#999"/>
                    <TextBlock x:Name="GapIntervalLabel"
                               Text="400 ms"
                               HorizontalAlignment="Center"
                               FontSize="14" FontWeight="Bold" Foreground="#FF9800"/>
                    <TextBlock Text="1500 ms" HorizontalAlignment="Right" FontSize="11" Foreground="#999"/>
                </Grid>
            </StackPanel>

            <!-- Test Süresi -->
            <TextBlock Text="Test Süresi (dakika):"
                       FontSize="15" Foreground="#333"
                       HorizontalAlignment="Center" Margin="0,20,0,6"/>

            <StackPanel Margin="0,0,0,4">
                <Slider x:Name="DurationSlider"
                        Minimum="1" Maximum="20"
                        Value="5"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        SmallChange="1" LargeChange="5"
                        ValueChanged="DurationSlider_ValueChanged"
                        Margin="0,0,0,4"/>
                <Grid>
                    <TextBlock Text="1 dk" HorizontalAlignment="Left" FontSize="11" Foreground="#999"/>
                    <TextBlock x:Name="DurationLabel"
                               Text="5 dakika"
                               HorizontalAlignment="Center"
                               FontSize="14" FontWeight="Bold" Foreground="#00897B"/>
                    <TextBlock Text="20 dk" HorizontalAlignment="Right" FontSize="11" Foreground="#999"/>
                </Grid>
            </StackPanel>

            <Button Content="▶  Testi Başlat"
                    Click="StartTest_Click"
                    Padding="20,12" FontSize="15" FontWeight="Bold"
                    Background="#00897B" Foreground="White"
                    Cursor="Hand" Width="200" Height="50"
                    Margin="0,16,0,0" HorizontalAlignment="Center"/>

            <Button Content="← Geri"
                    Click="BackButton_Click"
                    Padding="15,8" FontSize="12"
                    Background="#666" Foreground="White"
                    Cursor="Hand" Width="100"
                    HorizontalAlignment="Center"
                    Margin="0,12,0,0"/>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
