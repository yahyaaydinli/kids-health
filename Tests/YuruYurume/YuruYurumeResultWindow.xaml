<Window x:Class="PsikologTestApp.Tests.YuruYurume.YuruYurumeResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Yürü ve Yürüme - Sonuçlar" Height="760" Width="860"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="20,20,20,0">
            <StackPanel HorizontalAlignment="Stretch">

                <TextBlock Text="Test Sonuçlarınız"
                           FontSize="32" FontWeight="Bold" Foreground="#333"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>

                <!-- Özet -->
                <Border Background="White" CornerRadius="10" Padding="20"
                        BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sol kolon -->
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Test Türü: "      FontSize="14" Foreground="#666" Width="170"/>
                                <TextBlock x:Name="TestNameBlock"  FontSize="14" Foreground="#333" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Test Tarihi: "    FontSize="14" Foreground="#666" Width="170"/>
                                <TextBlock x:Name="TestDateBlock"  FontSize="14" Foreground="#333" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Yeşil Oranı: "    FontSize="14" Foreground="#666" Width="170"/>
                                <TextBlock x:Name="GoPercentBlock" FontSize="14" Foreground="#43A047" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Toplam Deneme: "  FontSize="14" Foreground="#666" Width="170"/>
                                <TextBlock x:Name="TotalBlock"     FontSize="14" Foreground="#333" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Yeşil (Bas): "    FontSize="14" Foreground="#666" Width="170"/>
                                <TextBlock x:Name="GoCountBlock"   FontSize="14" Foreground="#43A047" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Kırmızı (Basma): " FontSize="14" Foreground="#666" Width="170"/>
                                <TextBlock x:Name="NoGoCountBlock" FontSize="14" Foreground="#E53935" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Sağ kolon -->
                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="✅ Doğru Basış: "   FontSize="14" Foreground="#666" Width="170"/>
                                <TextBlock x:Name="HitBlock"         FontSize="14" Foreground="#43A047" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="⏱ Kaçırma: "        FontSize="14" Foreground="#666" Width="170"/>
                                <TextBlock x:Name="MissBlock"         FontSize="14" Foreground="#FF9800" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="❌ Yanlış Basış: "   FontSize="14" Foreground="#666" Width="170"/>
                                <TextBlock x:Name="FalseAlarmBlock"   FontSize="14" Foreground="#E53935" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Doğru Reddiye: "     FontSize="14" Foreground="#666" Width="170"/>
                                <TextBlock x:Name="CRBlock"           FontSize="14" Foreground="#2196F3" FontWeight="Bold"/>
                            </StackPanel>

                            <Separator Margin="0,8" Background="#EEE"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Basış Oranı: "       FontSize="14" Foreground="#666" Width="170"/>
                                <TextBlock x:Name="HitRateBlock"      FontSize="14" Foreground="#43A047" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Yanlış Alarm Oranı: " FontSize="14" Foreground="#666" Width="170"/>
                                <TextBlock x:Name="FABlock"            FontSize="14" Foreground="#E53935" FontWeight="Bold"/>
                            </StackPanel>

                            <Separator Margin="0,8" Background="#EEE"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Ort. Tepki Süresi: "  FontSize="14" Foreground="#666" Width="170"/>
                                <TextBlock x:Name="AvgBlock"           FontSize="14" Foreground="#4CAF50" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="En Hızlı Tepki: "     FontSize="14" Foreground="#666" Width="170"/>
                                <TextBlock x:Name="MinBlock"           FontSize="14" Foreground="#2196F3" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="En Yavaş Tepki: "     FontSize="14" Foreground="#666" Width="170"/>
                                <TextBlock x:Name="MaxBlock"           FontSize="14" Foreground="#FF5722" FontWeight="Bold"/>
                            </StackPanel>

                            <Separator Margin="0,8" Background="#EEE"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="🟢 Çok Basış (Yeşil): "   FontSize="14" Foreground="#666" Width="170"/>
                                <TextBlock x:Name="MultiGoBlock"       FontSize="14" Foreground="#C62828" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔴 Çok Basış (Kırmızı): " FontSize="14" Foreground="#666" Width="170"/>
                                <TextBlock x:Name="MultiNoGoBlock"     FontSize="14" Foreground="#C62828" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Timeline -->
                <TextBlock Text="Zaman Çizelgesi"
                           FontSize="18" FontWeight="Bold" Foreground="#333" Margin="0,0,0,8"/>
                <Border Background="White" CornerRadius="10"
                        BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,8" Padding="14,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="🟢" FontSize="13" Margin="0,0,2,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Yeşil (Bas)" FontSize="11" Foreground="#555" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <TextBlock Text="🔴" FontSize="13" Margin="0,0,2,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Kırmızı (Basma)" FontSize="11" Foreground="#555" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Kenarlık rengi:" FontSize="11" Foreground="#888" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <Rectangle Width="12" Height="12" Fill="Transparent" Stroke="#1B5E20" StrokeThickness="2.5" RadiusX="2" RadiusY="2" Margin="0,0,3,0"/>
                            <TextBlock Text="Doğru Basış" FontSize="11" Foreground="#555" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <Rectangle Width="12" Height="12" Fill="Transparent" Stroke="#E65100" StrokeThickness="2.5" RadiusX="2" RadiusY="2" Margin="0,0,3,0"/>
                            <TextBlock Text="Kaçırma" FontSize="11" Foreground="#555" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <Rectangle Width="12" Height="12" Fill="Transparent" Stroke="#B71C1C" StrokeThickness="2.5" RadiusX="2" RadiusY="2" Margin="0,0,3,0"/>
                            <TextBlock Text="Yanlış Basış" FontSize="11" Foreground="#555" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <Rectangle Width="12" Height="12" Fill="Transparent" Stroke="#0D47A1" StrokeThickness="2.5" RadiusX="2" RadiusY="2" Margin="0,0,3,0"/>
                            <TextBlock Text="Doğru Reddiye" FontSize="11" Foreground="#555" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Kutu içi: basış sayısı (×N) veya — (basılmadı)" FontSize="10" Foreground="#999" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="TimelineRows"/>
                    </StackPanel>
                </Border>

                <!-- Tablo -->
                <TextBlock Text="Ayrıntılı Deneme Raporu"
                           FontSize="18" FontWeight="Bold" Foreground="#333" Margin="0,0,0,8"/>
                <Border Background="White" CornerRadius="10"
                        BorderBrush="#DDD" BorderThickness="1"
                        Margin="0,0,0,24" Padding="0">
                    <DataGrid x:Name="TrialsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F7F7F7"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              BorderThickness="0"
                              RowHeight="34" FontSize="13">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#EEEEEE"/>
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="13"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="12,6"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding TrialNumber}" Width="44"/>

                            <!-- Uyaran: renkli sembol -->
                            <DataGridTemplateColumn Header="Uyaran" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Uyaran}"
                                                   Foreground="{Binding UyaranColor}"
                                                   FontWeight="Bold" FontSize="14"
                                                   VerticalAlignment="Center" Margin="12,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Sonuç: renkli metin -->
                            <DataGridTemplateColumn Header="Sonuç" Width="165">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Sonuc}"
                                                   Foreground="{Binding SonucColor}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   VerticalAlignment="Center" Margin="12,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Basış sayısı -->
                            <DataGridTemplateColumn Header="Basış Sayısı" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding BasisSayisi}"
                                                   Foreground="{Binding BasisSayisiColor}"
                                                   FontWeight="Bold" FontSize="14"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Margin="8,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Tepki Süresi" Binding="{Binding TepkiSuresi}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Butonlar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,12,0,16">
            <Button Content="🏠 Ana Sayfa"
                    Click="HomeButton_Click"
                    Padding="15,10" FontSize="14"
                    Background="#4CAF50" Foreground="White"
                    Cursor="Hand" Width="150" Height="45" Margin="0,0,15,0"/>
            <Button Content="🔄 Tekrar Et"
                    Click="RetryButton_Click"
                    Padding="15,10" FontSize="14"
                    Background="#00897B" Foreground="White"
                    Cursor="Hand" Width="150" Height="45" Margin="0,0,15,0"/>
            <Button Content="❌ Çık"
                    Click="ExitButton_Click"
                    Padding="15,10" FontSize="14"
                    Background="#F44336" Foreground="White"
                    Cursor="Hand" Width="150" Height="45"/>
        </StackPanel>
    </Grid>
</Window>
