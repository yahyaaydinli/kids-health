<Window x:Class="PsikologTestApp.Tests.Dedektif.DedektifStartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dedektif Testi" Height="700" Width="600"
        MinWidth="400" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel HorizontalAlignment="Center" MaxWidth="520" Margin="20,30,20,30">

            <!-- Başlık -->
            <TextBlock Text="🔍 Dedektif Testi"
                       FontSize="34" FontWeight="Bold"
                       Foreground="#1565C0"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- Açıklama -->
            <Border Background="White" CornerRadius="8"
                    BorderBrush="#E0E0E0" BorderThickness="1"
                    Padding="20" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="#444" LineHeight="24">
                        Bu testte ekranda renkli <Bold>şekiller</Bold> belirir.
                        Her denemenin başında bir <Bold>hedef figür</Bold> gösterilir. Görevin onu bulmak!
                    </TextBlock>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="14" Foreground="#444" LineHeight="24">
                        Yanlış tıklamalar sayılır — dikkatli ol!
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Figür Sayısı -->
            <Border Background="White" CornerRadius="8"
                    BorderBrush="#E0E0E0" BorderThickness="1"
                    Padding="20" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Ekrandaki Figür Sayısı:"
                               FontSize="15" FontWeight="Bold"
                               Foreground="#333" Margin="0,0,0,8"/>
                    <Slider x:Name="FigureCountSlider"
                            Minimum="4" Maximum="40" Value="16"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            SmallChange="1" LargeChange="4"
                            ValueChanged="FigureCountSlider_ValueChanged"
                            Margin="0,0,0,4"/>
                    <Grid>
                        <TextBlock Text="4"  HorizontalAlignment="Left"   FontSize="11" Foreground="#999"/>
                        <TextBlock x:Name="FigureCountLabel" Text="16 figür"
                                   HorizontalAlignment="Center"
                                   FontSize="14" FontWeight="Bold" Foreground="#1565C0"/>
                        <TextBlock Text="40" HorizontalAlignment="Right"  FontSize="11" Foreground="#999"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Geri Sayım Süresi -->
            <Border Background="White" CornerRadius="8"
                    BorderBrush="#E0E0E0" BorderThickness="1"
                    Padding="20" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Geri Sayım Süresi (test öncesi):"
                               FontSize="15" FontWeight="Bold"
                               Foreground="#333" Margin="0,0,0,8"/>
                    <Slider x:Name="CountdownSlider"
                            Minimum="1" Maximum="10" Value="3"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            SmallChange="1" LargeChange="1"
                            ValueChanged="CountdownSlider_ValueChanged"
                            Margin="0,0,0,4"/>
                    <Grid>
                        <TextBlock Text="1 sn" HorizontalAlignment="Left"   FontSize="11" Foreground="#999"/>
                        <TextBlock x:Name="CountdownLabel" Text="3 saniye"
                                   HorizontalAlignment="Center"
                                   FontSize="14" FontWeight="Bold" Foreground="#1565C0"/>
                        <TextBlock Text="10 sn" HorizontalAlignment="Right" FontSize="11" Foreground="#999"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Test Süresi -->
            <Border Background="White" CornerRadius="8"
                    BorderBrush="#E0E0E0" BorderThickness="1"
                    Padding="20" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Test Süresi (dakika):"
                               FontSize="15" FontWeight="Bold"
                               Foreground="#333" Margin="0,0,0,8"/>
                    <Slider x:Name="DurationSlider"
                            Minimum="1" Maximum="20" Value="5"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            SmallChange="1" LargeChange="5"
                            ValueChanged="DurationSlider_ValueChanged"
                            Margin="0,0,0,4"/>
                    <Grid>
                        <TextBlock Text="1 dk"  HorizontalAlignment="Left"   FontSize="11" Foreground="#999"/>
                        <TextBlock x:Name="DurationLabel" Text="5 dakika"
                                   HorizontalAlignment="Center"
                                   FontSize="14" FontWeight="Bold" Foreground="#1565C0"/>
                        <TextBlock Text="20 dk" HorizontalAlignment="Right"  FontSize="11" Foreground="#999"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Başlat -->
            <Button Content="▶  Testi Başlat"
                    Click="StartTest_Click"
                    Padding="20,12" FontSize="15" FontWeight="Bold"
                    Background="#1565C0" Foreground="White"
                    Cursor="Hand" Width="220" Height="52"
                    HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <!-- Geri -->
            <Button Content="← Geri"
                    Click="BackButton_Click"
                    Padding="15,8" FontSize="12"
                    Background="#666666" Foreground="White"
                    Cursor="Hand" Width="100"
                    HorizontalAlignment="Center"/>

        </StackPanel>
    </ScrollViewer>
</Window>
