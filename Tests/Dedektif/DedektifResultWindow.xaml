<Window x:Class="PsikologTestApp.Tests.Dedektif.DedektifResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dedektif Testi — Sonuçlar" Height="720" Width="820"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="20,20,20,0">
            <StackPanel HorizontalAlignment="Stretch">

                <TextBlock Text="Test Sonuçlarınız"
                           FontSize="32" FontWeight="Bold" Foreground="#333"
                           HorizontalAlignment="Center" Margin="0,0,0,18"/>

                <!-- Özet Kutusu -->
                <Border Background="White" CornerRadius="10" Padding="24"
                        BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sol sütun: Test bilgisi -->
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Test Türü: "    FontSize="14" Foreground="#666" Width="160"/>
                                <TextBlock x:Name="TestNameBlock" FontSize="14" Foreground="#333" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Test Tarihi: "  FontSize="14" Foreground="#666" Width="160"/>
                                <TextBlock x:Name="TestDateBlock" FontSize="14" Foreground="#333" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Figür Sayısı: " FontSize="14" Foreground="#666" Width="160"/>
                                <TextBlock x:Name="FigureCountBlock" FontSize="14" Foreground="#1565C0" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Süre: "         FontSize="14" Foreground="#666" Width="160"/>
                                <TextBlock x:Name="DurationBlock" FontSize="14" Foreground="#333" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Sağ sütun: Performans -->
                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="✅ Bulunan Hedef: " FontSize="14" Foreground="#666" Width="180"/>
                                <TextBlock x:Name="FoundBlock"       FontSize="14" Foreground="#43A047" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="❌ Toplam Yanlış: " FontSize="14" Foreground="#666" Width="180"/>
                                <TextBlock x:Name="WrongBlock"       FontSize="14" Foreground="#E53935" FontWeight="Bold"/>
                            </StackPanel>

                            <Separator Margin="0,8" Background="#EEE"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Ort. Tepki Süresi: " FontSize="14" Foreground="#666" Width="180"/>
                                <TextBlock x:Name="AvgBlock"          FontSize="14" Foreground="#4CAF50" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="En Hızlı Tepki: "    FontSize="14" Foreground="#666" Width="180"/>
                                <TextBlock x:Name="MinBlock"          FontSize="14" Foreground="#2196F3" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="En Yavaş Tepki: "    FontSize="14" Foreground="#666" Width="180"/>
                                <TextBlock x:Name="MaxBlock"          FontSize="14" Foreground="#FF5722" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Timeline -->
                <TextBlock Text="Zaman Çizelgesi"
                           FontSize="18" FontWeight="Bold" Foreground="#333" Margin="0,0,0,8"/>
                <Border Background="White" CornerRadius="10"
                        BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,8" Padding="14,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Background="#20E53935" BorderBrush="#E53935" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,4,0">
                                <TextBlock Text="K■" FontSize="10" FontWeight="Bold" Foreground="#C62828"/>
                            </Border>
                            <TextBlock Text="Yanlış tıklama (kısaltılmış renk+şekil)" FontSize="11" Foreground="#555" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <Border Background="#2043A047" BorderBrush="#43A047" BorderThickness="1.5" CornerRadius="3" Padding="4,1" Margin="0,0,4,0">
                                <TextBlock Text="✅ Y★" FontSize="10" FontWeight="SemiBold" Foreground="#1B5E20"/>
                            </Border>
                            <TextBlock Text="Hedef bulundu" FontSize="11" Foreground="#555" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <Border Background="#20FF9800" BorderBrush="#FF9800" BorderThickness="1.5" CornerRadius="3" Padding="4,1" Margin="0,0,4,0">
                                <TextBlock Text="⏱" FontSize="10" Foreground="#E65100"/>
                            </Border>
                            <TextBlock Text="Kaçırıldı (süre bitti)" FontSize="11" Foreground="#555" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ItemsControl x:Name="TimelineRows"/>
                    </StackPanel>
                </Border>

                <!-- Ayrıntılı Tablo -->
                <TextBlock Text="Ayrıntılı Deneme Raporu"
                           FontSize="18" FontWeight="Bold" Foreground="#333" Margin="0,0,0,8"/>
                <Border Background="White" CornerRadius="10"
                        BorderBrush="#DDD" BorderThickness="1"
                        Margin="0,0,0,24" Padding="0">
                    <DataGrid x:Name="TrialsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F7F7F7"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              BorderThickness="0"
                              RowHeight="34" FontSize="13">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#EEEEEE"/>
                                <Setter Property="Padding"    Value="12,8"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize"   Value="13"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding"         Value="12,6"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#"                Binding="{Binding TrialNumber}"   Width="44"/>
                            <DataGridTextColumn Header="Hedef"            Binding="{Binding TargetName}"   Width="160"/>
                            <DataGridTextColumn Header="Tepki Süresi"     Binding="{Binding TepkiSuresi}"  Width="130"/>
                            <DataGridTextColumn Header="Yanlış Tıklama (sayı + isimler)"   Binding="{Binding WrongClicks}"  Width="*"/>
                            <DataGridTemplateColumn Header="Sonuç" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Sonuc}"
                                                   Foreground="{Binding SonucColor}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   VerticalAlignment="Center" Margin="12,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Alt butonlar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,12,0,16">
            <Button Content="🏠 Ana Sayfa"
                    Click="HomeButton_Click"
                    Padding="15,10" FontSize="14"
                    Background="#4CAF50" Foreground="White"
                    Cursor="Hand" Width="150" Height="45" Margin="0,0,15,0"/>
            <Button Content="🔄 Tekrar Et"
                    Click="RetryButton_Click"
                    Padding="15,10" FontSize="14"
                    Background="#1565C0" Foreground="White"
                    Cursor="Hand" Width="150" Height="45" Margin="0,0,15,0"/>
            <Button Content="❌ Çık"
                    Click="ExitButton_Click"
                    Padding="15,10" FontSize="14"
                    Background="#F44336" Foreground="White"
                    Cursor="Hand" Width="150" Height="45"/>
        </StackPanel>
    </Grid>
</Window>
