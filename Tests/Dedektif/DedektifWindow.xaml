<Window x:Class="PsikologTestApp.Tests.Dedektif.DedektifWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dedektif Testi" Height="700" Width="900"
        MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="#ECEFF1"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="66"/>   <!-- üst bilgi çubuğu -->
            <RowDefinition Height="96"/>   <!-- hedef gösterimi -->
            <RowDefinition Height="*"/>    <!-- figür ızgarası -->
        </Grid.RowDefinitions>

        <!-- ── Üst bilgi çubuğu ────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="#1565C0">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="✅ " FontSize="15" Foreground="#B3E5FC" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TrialCountBlock"
                               Text="0" FontSize="18" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="bulundu" FontSize="14" Foreground="#B3E5FC" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="🔍 Dedektif Testi"
                           FontSize="20" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="❌ " FontSize="14" Foreground="#FFCDD2" VerticalAlignment="Center"/>
                    <TextBlock x:Name="WrongClicksBlock"
                               Text="0" FontSize="16" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBlock Text="⏱ " FontSize="14" Foreground="#B3E5FC" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TimerBlock"
                               Text="05:00" FontSize="22" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Button Content="⏹ Bitir" Click="EndTestButton_Click"
                            Padding="10,4" FontSize="13" FontWeight="Bold"
                            Background="#E53935" Foreground="White"
                            Cursor="Hand" Height="36" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Hedef gösterimi ──────────────────────────────────────────────── -->
        <Border Grid.Row="1" Background="White"
                BorderBrush="#CFD8DC" BorderThickness="0,0,0,2">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Hedef ► "
                           FontSize="18" Foreground="#546E7A"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="TargetSymbolBlock"
                           Text="■" FontSize="54" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,-6,12,0"/>
                <TextBlock x:Name="TargetNameBlock"
                           Text="kırmızı kare" FontSize="28" FontWeight="Bold"
                           Foreground="#263238" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ── Figür ızgarası ─────────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="10">
            <UniformGrid x:Name="FigureGrid" HorizontalAlignment="Center"/>
        </ScrollViewer>

        <!-- ── Geri sayım overlay (tüm satırları kaplayan) ────────────────────── -->
        <Grid x:Name="CountdownOverlay" Grid.RowSpan="3"
              Background="#F01565C0" Panel.ZIndex="10">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="CountdownNumber"
                           Text="3" FontSize="220" FontWeight="Black"
                           Foreground="White" HorizontalAlignment="Center"
                           Margin="0,0,0,-30"/>
                <TextBlock Text="Hazırın mı?"
                           FontSize="28" Foreground="#B3E5FC"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
        <!-- ── Duraklat overlay ─────────────────────────────────────── -->
        <Grid x:Name="PauseOverlay" Grid.RowSpan="3"
              Background="#CC000000" Panel.ZIndex="20" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⏸ Test Duraklatıldı"
                           FontSize="36" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="▶ Devam Et" Click="ResumeButton_Click"
                            Padding="20,12" FontSize="16" FontWeight="Bold"
                            Background="#43A047" Foreground="White"
                            Cursor="Hand" Width="180" Height="52" Margin="0,0,20,0"/>
                    <Button Content="⏹ Testi Bitir" Click="EndTestButton_Click"
                            Padding="20,12" FontSize="16" FontWeight="Bold"
                            Background="#E53935" Foreground="White"
                            Cursor="Hand" Width="180" Height="52"/>
                </StackPanel>
            </StackPanel>
        </Grid>    </Grid>
</Window>
