<Window x:Class="PsikologTestApp.Tests.RenkliKelimeler.RenkliKelimelerStartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Renkli Kelimeler Testi - Başlat" Height="540" Width="600"
        MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel HorizontalAlignment="Center" Width="500" Margin="20,30,20,30">

            <TextBlock Text="Renkli Kelimeler Testi"
                       FontSize="36" FontWeight="Bold"
                       Foreground="#333333"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24"/>

            <!-- Açıklama -->
            <Border Background="White" CornerRadius="10" Padding="20"
                    BorderBrush="#DDD" BorderThickness="1"
                    Margin="0,0,0,28">
                <StackPanel>
                    <TextBlock FontSize="14" Foreground="#555" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,0,0,12">
                        <Run Text="Ekranda bir renk kelimesi görünecek."/>
                        <LineBreak/>
                        <Run Text="Kelimenin rengi farklı bir renge boyanmış olacak."/>
                        <LineBreak/>
                        <Run FontWeight="Bold" Foreground="#E53935"
                             Text="Kelimenin yazıldığı RENK rengini seçin"/>
                        <Run Text=" (kelimenin anlamını değil)."/>
                    </TextBlock>

                    <!-- Mini örnek -->
                    <Border Background="#F0F0F0" CornerRadius="8" Padding="14,10"
                            HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Örnek: " FontSize="13" Foreground="#888"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="KIRMIZI" FontSize="22" FontWeight="Bold"
                                       Foreground="#2196F3" VerticalAlignment="Center"
                                       Margin="6,0,0,0"/>
                            <TextBlock Text=" → MAVİ butonuna basılır"
                                       FontSize="13" Foreground="#555"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Süre seçimi -->
            <TextBlock Text="Test Süresi (dakika):"
                       FontSize="16" Foreground="#333333"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6"/>

            <StackPanel Margin="0,0,0,4">
                <Slider x:Name="DurationSlider"
                        Minimum="1" Maximum="20"
                        Value="5"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        SmallChange="1" LargeChange="5"
                        ValueChanged="DurationSlider_ValueChanged"
                        Margin="0,0,0,4"/>
                <Grid>
                    <TextBlock Text="1 dk" HorizontalAlignment="Left" FontSize="11" Foreground="#999999"/>
                    <TextBlock x:Name="DurationLabel"
                               Text="5 dakika"
                               HorizontalAlignment="Center"
                               FontSize="14" FontWeight="Bold" Foreground="#2196F3"/>
                    <TextBlock Text="20 dk" HorizontalAlignment="Right" FontSize="11" Foreground="#999999"/>
                </Grid>
            </StackPanel>

            <Button Content="▶  Testi Başlat"
                    Click="StartTest_Click"
                    Padding="20,12" FontSize="15" FontWeight="Bold"
                    Background="#2196F3" Foreground="White"
                    Cursor="Hand" Width="200" Height="50"
                    Margin="0,16,0,0" HorizontalAlignment="Center"/>

            <Button Content="← Geri"
                    Click="BackButton_Click"
                    Padding="15,8" FontSize="12"
                    Background="#666666" Foreground="White"
                    Cursor="Hand" Width="100"
                    HorizontalAlignment="Center"
                    Margin="0,12,0,0"/>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
