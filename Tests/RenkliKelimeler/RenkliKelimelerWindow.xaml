<Window x:Class="PsikologTestApp.Tests.RenkliKelimeler.RenkliKelimelerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Renkli Kelimeler Testi"
        WindowStyle="None"
        WindowState="Maximized"
        Background="#111111"
        Foreground="White"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>   <!-- Üst bar -->
            <RowDefinition Height="*"/>    <!-- Kelime alanı -->
            <RowDefinition Height="Auto"/> <!-- Renk butonları -->
            <RowDefinition Height="20"/>   <!-- Alt boşluk -->
        </Grid.RowDefinitions>

        <!-- Üst Bar -->
        <Border Grid.Row="0" Background="#1a1a1a" Padding="24,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Renkli Kelimeler"
                           FontSize="22" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,40,0"/>

                <TextBlock Text="Kalan Süre: "
                           FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="TimeDisplay" Text="05:00"
                           FontSize="26" FontWeight="Bold"
                           Foreground="#FF9800" VerticalAlignment="Center"
                           MinWidth="100"/>

                <TextBlock Text="Doğru: " FontSize="16"
                           VerticalAlignment="Center" Margin="40,0,8,0"/>
                <TextBlock x:Name="CorrectCountDisplay" Text="0"
                           FontSize="22" FontWeight="Bold"
                           Foreground="#4CAF50" VerticalAlignment="Center"
                           MinWidth="40"/>

                <TextBlock Text="Yanlış: " FontSize="16"
                           VerticalAlignment="Center" Margin="20,0,8,0"/>
                <TextBlock x:Name="WrongCountDisplay" Text="0"
                           FontSize="22" FontWeight="Bold"
                           Foreground="#F44336" VerticalAlignment="Center"
                           MinWidth="40"/>

                <Button Content="⏹ Bitir" Click="EndTestButton_Click"
                        Padding="10,4" FontSize="13" FontWeight="Bold"
                        Background="#E53935" Foreground="White"
                        Cursor="Hand" Height="40" BorderThickness="0"
                        Margin="40,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Kelime alanı -->
        <Grid Grid.Row="1">
            <!-- Geri bildirim göstergesi (doğru/yanlış) -->
            <Border x:Name="FeedbackBorder"
                    CornerRadius="16" Padding="20,10"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,24,0,0"
                    Opacity="0">
                <TextBlock x:Name="FeedbackText"
                           FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- Ana kelime -->
            <TextBlock x:Name="WordDisplay"
                       Text=""
                       FontSize="200"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Opacity="0"/>

            <!-- Başlat talimatı -->
            <TextBlock x:Name="HintBlock"
                       Text="Başlamak için herhangi bir tuşa basın"
                       FontSize="22"
                       Foreground="#AAAAAA"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Renk Butonları -->
        <Border Grid.Row="2" Background="#1a1a1a" Padding="0,18">
            <Border.Resources>
                <Style x:Key="ColorButtonStyle" TargetType="Button">
                    <Setter Property="Width" Value="170"/>
                    <Setter Property="Height" Value="70"/>
                    <Setter Property="Margin" Value="12,0"/>
                    <Setter Property="BorderThickness" Value="4"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="Transparent"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="White"/>
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Resources>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="BtnKirmizi"
                        Tag="KIRMIZI"
                        Click="ColorButton_Click"
                        Background="#E53935"
                        Style="{StaticResource ColorButtonStyle}"/>

                <Button x:Name="BtnMavi"
                        Tag="MAVİ"
                        Click="ColorButton_Click"
                        Background="#1E88E5"
                        Style="{StaticResource ColorButtonStyle}"/>

                <Button x:Name="BtnYesil"
                        Tag="YEŞİL"
                        Click="ColorButton_Click"
                        Background="#43A047"
                        Style="{StaticResource ColorButtonStyle}"/>

                <Button x:Name="BtnSari"
                        Tag="SARI"
                        Click="ColorButton_Click"
                        Background="#FDD835"
                        Style="{StaticResource ColorButtonStyle}"/>
            </StackPanel>
        </Border>
        <!-- Duraklat Overlay -->
        <Grid x:Name="PauseOverlay" Grid.RowSpan="4"
              Panel.ZIndex="20" Background="#CC000000" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⏸ Test Duraklatıldı"
                           FontSize="36" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="▶ Devam Et" Click="ResumeButton_Click"
                            Padding="20,12" FontSize="16" FontWeight="Bold"
                            Background="#43A047" Foreground="White"
                            Cursor="Hand" Width="180" Height="52" Margin="0,0,20,0"/>
                    <Button Content="⏹ Testi Bitir" Click="EndTestButton_Click"
                            Padding="20,12" FontSize="16" FontWeight="Bold"
                            Background="#E53935" Foreground="White"
                            Cursor="Hand" Width="180" Height="52"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
