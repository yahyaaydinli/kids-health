<Window x:Class="PsikologTestApp.Tests.HedefAvcisi.HedefAvcisiResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Test Sonuçları" Height="720" Width="780"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="20,20,20,0">
            <StackPanel HorizontalAlignment="Stretch">
                <TextBlock Text="Test Sonuçlarınız" 
                           FontSize="32" 
                           FontWeight="Bold" 
                           Foreground="#333333"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>

                <!-- Özet İstatistikler -->
                <Border Background="White" 
                       CornerRadius="10"
                       Padding="20"
                       BorderBrush="#DDD"
                       BorderThickness="1"
                       Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Test Türü: " FontSize="14" Foreground="#666666" Width="200"/>
                            <TextBlock x:Name="TestNameBlock" Text="Hedef Avcısı" FontSize="14" Foreground="#333333" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Test Tarihi: " FontSize="14" Foreground="#666666" Width="200"/>
                            <TextBlock x:Name="TestDateBlock" Text="--" FontSize="14" Foreground="#333333" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Aranan Harf: " FontSize="14" Foreground="#666666" Width="200"/>
                            <TextBlock x:Name="TargetLetterBlock" Text="--" FontSize="20" Foreground="#4CAF50" FontWeight="Bold"/>
                        </StackPanel>

                        <Separator Margin="0,8,0,8" Background="#EEE"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Ort. Bekleme Süresi: " FontSize="14" Foreground="#666666" Width="200"/>
                            <TextBlock x:Name="AvgWaitBlock" Text="--" FontSize="14" Foreground="#FF9800" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Ort. Tepki Süresi: " FontSize="14" Foreground="#666666" Width="200"/>
                            <TextBlock x:Name="AverageBlock" Text="--" FontSize="14" Foreground="#4CAF50" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="En Hızlı Tepki: " FontSize="14" Foreground="#666666" Width="200"/>
                            <TextBlock x:Name="MinBlock" Text="--" FontSize="14" Foreground="#2196F3" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="En Yavaş Tepki: " FontSize="14" Foreground="#666666" Width="200"/>
                            <TextBlock x:Name="MaxBlock" Text="--" FontSize="14" Foreground="#FF5722" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Toplam Doğru Basış: " FontSize="14" Foreground="#666666" Width="200"/>
                            <TextBlock x:Name="CountBlock" Text="--" FontSize="14" Foreground="#333333" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Yanlış Basış: " FontSize="14" Foreground="#666666" Width="200"/>
                            <TextBlock x:Name="FalsePressCountBlock" Text="--" FontSize="14" Foreground="#f44336" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Çift Basış: " FontSize="14" Foreground="#666666" Width="200"/>
                            <TextBlock x:Name="MultiPressCountBlock" Text="--" FontSize="14" Foreground="#FF9800" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Timeline -->
                <TextBlock Text="Zaman Çizelgesi"
                           FontSize="18" FontWeight="Bold" Foreground="#333" Margin="0,0,0,8"/>
                <Border Background="White" CornerRadius="10"
                        BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,8" Padding="14,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Rectangle Width="18" Height="12" Fill="#43A047" RadiusX="2" RadiusY="2" Margin="0,0,4,0"/>
                            <TextBlock Text="Doğru" FontSize="11" Foreground="#555" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <Rectangle Width="18" Height="12" Fill="#E53935" RadiusX="2" RadiusY="2" Margin="0,0,4,0"/>
                            <TextBlock Text="Yanlış" FontSize="11" Foreground="#555" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <Rectangle Width="18" Height="12" Fill="#FF9800" RadiusX="2" RadiusY="2" Margin="0,0,4,0"/>
                            <TextBlock Text="Çift Basış" FontSize="11" Foreground="#555" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <Rectangle Width="18" Height="12" Fill="#B0BEC5" RadiusX="2" RadiusY="2" Margin="0,0,4,0"/>
                            <TextBlock Text="Bekleme" FontSize="11" Foreground="#555" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ItemsControl x:Name="TimelineRows"/>
                    </StackPanel>
                </Border>

                <!-- Ayrıntılı Rapor -->
                <TextBlock Text="Ayrıntılı Görünüm Raporu" 
                           FontSize="18" FontWeight="Bold" Foreground="#333333"
                           Margin="0,0,0,8"/>
                <Border Background="White"
                        CornerRadius="10"
                        BorderBrush="#DDD"
                        BorderThickness="1"
                        Margin="0,0,0,24"
                        Padding="0">
                    <DataGrid x:Name="AppearanceDetailsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F7F7F7"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              BorderThickness="0"
                              RowHeight="34"
                              FontSize="13">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#EEEEEE"/>
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="13"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="12,6"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding RowIndex}" Width="40"/>
                            <DataGridTextColumn Header="Sonuç" Binding="{Binding Sonuc}" Width="90"/>
                            <DataGridTextColumn Header="Gösterilen Harf" Binding="{Binding GosterHarf}" Width="110"/>
                            <DataGridTextColumn Header="Harf Çıkana Kadar Bekleme" Binding="{Binding WaitTime}" Width="*"/>
                            <DataGridTextColumn Header="Harfe Basana Kadar Tepki" Binding="{Binding ReactionTime}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Butonlar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,12,0,16">
            <Button Content="🏠 Ana Sayfa" 
                    Click="HomeButton_Click"
                    Padding="15,10" FontSize="14"
                    Background="#4CAF50" Foreground="White"
                    Cursor="Hand" Width="150" Height="45" Margin="0,0,15,0"/>
            <Button Content="🔄 Tekrar Et" 
                    Click="RetryButton_Click"
                    Padding="15,10" FontSize="14"
                    Background="#2196F3" Foreground="White"
                    Cursor="Hand" Width="150" Height="45" Margin="0,0,15,0"/>
            <Button Content="❌ Çık" 
                    Click="ExitButton_Click"
                    Padding="15,10" FontSize="14"
                    Background="#f44336" Foreground="White"
                    Cursor="Hand" Width="150" Height="45"/>
        </StackPanel>
    </Grid>
</Window>
