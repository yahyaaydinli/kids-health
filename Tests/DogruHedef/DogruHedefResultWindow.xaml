<Window x:Class="PsikologTestApp.Tests.DogruHedef.DogruHedefResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Doğru Hedef Testi — Sonuçlar" Height="760" Width="880"
        MinWidth="540" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="20,20,20,0">
            <StackPanel HorizontalAlignment="Stretch">

                <TextBlock Text="Doğru Hedef — Sonuçlar"
                           FontSize="32" FontWeight="Bold" Foreground="#333"
                           HorizontalAlignment="Center" Margin="0,0,0,18"/>

                <!-- Özet kutusu -->
                <Border Background="White" CornerRadius="10" Padding="24"
                        BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sol: genel bilgi -->
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Test Türü: "          FontSize="14" Foreground="#666" Width="170"/>
                                <TextBlock x:Name="TestNameBlock"      FontSize="14" Foreground="#333" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Test Tarihi: "        FontSize="14" Foreground="#666" Width="170"/>
                                <TextBlock x:Name="TestDateBlock"      FontSize="14" Foreground="#333" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Hedef Hayvan: "       FontSize="14" Foreground="#666" Width="170"/>
                                <TextBlock x:Name="TargetAnimalBlock"  FontSize="14" Foreground="#1565C0" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Test Süresi: "        FontSize="14" Foreground="#666" Width="170"/>
                                <TextBlock x:Name="DurationBlock"      FontSize="14" Foreground="#333" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Toplam Segment: "     FontSize="14" Foreground="#666" Width="170"/>
                                <TextBlock x:Name="TotalSegBlock"      FontSize="14" Foreground="#333" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Sağ: performans -->
                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="🎯 Hedef Görünümü: "   FontSize="14" Foreground="#666" Width="186"/>
                                <TextBlock x:Name="TargetCountBlock"    FontSize="14" Foreground="#333" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="✅ İsabet (Hit): "      FontSize="14" Foreground="#666" Width="186"/>
                                <TextBlock x:Name="HitBlock"            FontSize="14" Foreground="#43A047" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="❌ Kaçırılan: "         FontSize="14" Foreground="#666" Width="186"/>
                                <TextBlock x:Name="MissBlock"           FontSize="14" Foreground="#E53935" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="🎯 İsabet Oranı: "      FontSize="14" Foreground="#666" Width="186"/>
                                <TextBlock x:Name="HitRateBlock"        FontSize="14" Foreground="#1565C0" FontWeight="Bold"/>
                            </StackPanel>
                            <Separator Margin="0,8" Background="#EEE"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="⚠️ Yanlış (Boşluk): "  FontSize="14" Foreground="#666" Width="186"/>
                                <TextBlock x:Name="FalseGapBlock"       FontSize="14" Foreground="#FF6F00" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="⚠️ Yanlış (Hayvan): "  FontSize="14" Foreground="#666" Width="186"/>
                                <TextBlock x:Name="FalseOtherBlock"     FontSize="14" Foreground="#FF6F00" FontWeight="Bold"/>
                            </StackPanel>
                            <Separator Margin="0,8" Background="#EEE"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏱ Ort. Tepki Süresi: " FontSize="14" Foreground="#666" Width="186"/>
                                <TextBlock x:Name="AvgRtBlock"          FontSize="14" Foreground="#4CAF50" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── Timeline görselleştirme ── -->
                <TextBlock Text="Zaman Çizelgesi"
                           FontSize="18" FontWeight="Bold" Foreground="#333" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#888" Margin="0,0,0,8">
                    Her segment süreyle orantılı gösterilir. Dikey çizgiler SPACE basışlarını, renk kodlaması segment türünü belirtir.
                </TextBlock>

                <!-- Renk açıklaması -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Rectangle Width="18" Height="18" Fill="#388E3C"  RadiusX="3" RadiusY="3" Margin="0,0,4,0"/>
                    <TextBlock Text="Hedef" FontSize="12" Foreground="#555" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Rectangle Width="18" Height="18" Fill="#1565C0"  RadiusX="3" RadiusY="3" Margin="0,0,4,0"/>
                    <TextBlock Text="Diğer Hayvan" FontSize="12" Foreground="#555" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Rectangle Width="18" Height="18" Fill="#B0BEC5"  RadiusX="3" RadiusY="3" Margin="0,0,4,0"/>
                    <TextBlock Text="Boşluk" FontSize="12" Foreground="#555" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Rectangle Width="3"  Height="18" Fill="#E53935"  Margin="0,0,4,0"/>
                    <TextBlock Text="Basış" FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Background="White" CornerRadius="10"
                        BorderBrush="#DDD" BorderThickness="1"
                        Margin="0,0,0,18" Padding="16">
                    <ItemsControl x:Name="TimelineRows"/>
                </Border>

                <!-- Segment tablosu -->
                <TextBlock Text="Segment Detayları"
                           FontSize="18" FontWeight="Bold" Foreground="#333" Margin="0,0,0,8"/>
                <TextBlock Text="Her satır bir segment (hayvan gösterimi veya boşluk) ve o sırada yapılan basışları gösterir."
                           FontSize="12" Foreground="#888" Margin="0,0,0,8" TextWrapping="Wrap"/>

                <Border Background="White" CornerRadius="10"
                        BorderBrush="#DDD" BorderThickness="1"
                        Margin="0,0,0,24" Padding="0">
                    <DataGrid x:Name="SegmentsGrid"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F7F7F7"
                              CanUserReorderColumns="False" CanUserResizeRows="False"
                              EnableRowVirtualization="True"
                              BorderThickness="0" RowHeight="34" FontSize="13">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#EEEEEE"/>
                                <Setter Property="Padding"    Value="10,8"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize"   Value="13"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding"         Value="10,6"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#"              Binding="{Binding No}"          Width="44"/>
                            <DataGridTemplateColumn Header="Segment"    Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Segment}"
                                                   Foreground="{Binding SegmentColor}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   VerticalAlignment="Center" Margin="10,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Süre"           Binding="{Binding SureMs}"      Width="90"/>
                            <DataGridTextColumn Header="Basış"          Binding="{Binding PressCount}"  Width="66"/>
                            <DataGridTemplateColumn Header="Sonuç"      Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Sonuc}"
                                                   Foreground="{Binding SonucColor}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   VerticalAlignment="Center" Margin="10,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Basış Zamanları (ms cinsinden segment başından itibaren)"
                                                Binding="{Binding Zamanlar}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Alt butonlar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,12,0,16">
            <Button Content="🏠 Ana Sayfa"  Click="HomeButton_Click"
                    Padding="15,10" FontSize="14" Background="#4CAF50" Foreground="White"
                    Cursor="Hand" Width="150" Height="45" Margin="0,0,15,0"/>
            <Button Content="🔄 Tekrar Et"  Click="RetryButton_Click"
                    Padding="15,10" FontSize="14" Background="#1565C0" Foreground="White"
                    Cursor="Hand" Width="150" Height="45" Margin="0,0,15,0"/>
            <Button Content="❌ Çık"         Click="ExitButton_Click"
                    Padding="15,10" FontSize="14" Background="#F44336" Foreground="White"
                    Cursor="Hand" Width="150" Height="45"/>
        </StackPanel>
    </Grid>
</Window>
