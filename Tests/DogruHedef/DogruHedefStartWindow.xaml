<Window x:Class="PsikologTestApp.Tests.DogruHedef.DogruHedefStartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Doğru Hedef Testi" Height="820" Width="700"
        MinWidth="440" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="AnimalCard" TargetType="RadioButton">
            <Setter Property="GroupName"       Value="AnimalGroup"/>
            <Setter Property="Width"           Value="108"/>
            <Setter Property="Height"          Value="118"/>
            <Setter Property="Margin"          Value="6"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="2.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="BorderBrush" Value="#1565C0"/>
                                <Setter Property="Background"  Value="#E3F2FD"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#1565C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel HorizontalAlignment="Center" MaxWidth="640" Margin="20,28,20,28">

            <TextBlock Text="🎯 Doğru Hedef Testi"
                       FontSize="34" FontWeight="Bold" Foreground="#1565C0"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- Açıklama -->
            <Border Background="White" CornerRadius="8"
                    BorderBrush="#E0E0E0" BorderThickness="1"
                    Padding="20" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="#444" LineHeight="24">
                        Ekranda sırayla hayvan görselleri belirir. Her görselin ardından kısa bir <Bold>boşluk</Bold> gelir.
                    </TextBlock>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="14" Foreground="#444" LineHeight="24">
                        <Bold>Hedef hayvanı</Bold> gördüğünde <Bold>SPACE</Bold> tuşuna bas.
                        Diğer hayvanlarda ve boşluklarda <Bold>basma</Bold>!
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Hayvan Seçimi -->
            <Border Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1"
                    Padding="20" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Hedef Hayvanı Seçin:" FontSize="15" FontWeight="Bold"
                               Foreground="#333" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                        <RadioButton x:Name="AnimalKediRadio"    Style="{StaticResource AnimalCard}" IsChecked="True">
                            <TextBlock Text="🐱" FontSize="56" HorizontalAlignment="Center" Margin="0,8,0,8"/>
                        </RadioButton>

                        <RadioButton x:Name="AnimalKopekRadio"   Style="{StaticResource AnimalCard}">
                            <TextBlock Text="🐶" FontSize="56" HorizontalAlignment="Center" Margin="0,8,0,8"/>
                        </RadioButton>

                        <RadioButton x:Name="AnimalKurbagaRadio" Style="{StaticResource AnimalCard}">
                            <TextBlock Text="🐸" FontSize="56" HorizontalAlignment="Center" Margin="0,8,0,8"/>
                        </RadioButton>

                        <RadioButton x:Name="AnimalTavsanRadio"  Style="{StaticResource AnimalCard}">
                            <TextBlock Text="🐰" FontSize="56" HorizontalAlignment="Center" Margin="0,8,0,8"/>
                        </RadioButton>

                        <RadioButton x:Name="AnimalTilkiRadio"   Style="{StaticResource AnimalCard}">
                            <TextBlock Text="🦊" FontSize="56" HorizontalAlignment="Center" Margin="0,8,0,8"/>
                        </RadioButton>

                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Test Süresi -->
            <Border Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1"
                    Padding="20" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Test Süresi (dakika):" FontSize="15" FontWeight="Bold"
                               Foreground="#333" Margin="0,0,0,8"/>
                    <Slider x:Name="DurationSlider" Minimum="1" Maximum="20" Value="5"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            SmallChange="1" LargeChange="5"
                            ValueChanged="DurationSlider_ValueChanged" Margin="0,0,0,4"/>
                    <Grid>
                        <TextBlock Text="1 dk"  HorizontalAlignment="Left"  FontSize="11" Foreground="#999"/>
                        <TextBlock x:Name="DurationLabel" Text="5 dakika"
                                   HorizontalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="#1565C0"/>
                        <TextBlock Text="20 dk" HorizontalAlignment="Right" FontSize="11" Foreground="#999"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Geri Sayım -->
            <Border Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1"
                    Padding="20" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Geri Sayım Süresi (test öncesi):" FontSize="15" FontWeight="Bold"
                               Foreground="#333" Margin="0,0,0,8"/>
                    <Slider x:Name="CountdownSlider" Minimum="1" Maximum="5" Value="3"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            SmallChange="1" LargeChange="1"
                            ValueChanged="CountdownSlider_ValueChanged" Margin="0,0,0,4"/>
                    <Grid>
                        <TextBlock Text="1 sn" HorizontalAlignment="Left"  FontSize="11" Foreground="#999"/>
                        <TextBlock x:Name="CountdownLabel" Text="3 saniye"
                                   HorizontalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="#1565C0"/>
                        <TextBlock Text="5 sn" HorizontalAlignment="Right" FontSize="11" Foreground="#999"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Uyaran Görünme Süresi (ms) -->
            <Border Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1"
                    Padding="20" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Uyaran Görünme Süresi (ms):" FontSize="15" FontWeight="Bold"
                               Foreground="#333" Margin="0,0,0,12"/>
                    <!-- Min -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="72"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Min:" Grid.Column="0" FontSize="13" Foreground="#555"
                                   VerticalAlignment="Center"/>
                        <Slider x:Name="MinMsSlider" Grid.Column="1"
                                Minimum="100" Maximum="10000" Value="100"
                                TickFrequency="100" IsSnapToTickEnabled="True"
                                SmallChange="100" LargeChange="500"
                                ValueChanged="MinMsSlider_ValueChanged" Margin="0,0,8,0"/>
                        <TextBlock x:Name="MinMsLabel" Grid.Column="2" Text="100 ms"
                                   FontSize="13" FontWeight="Bold" Foreground="#1565C0"
                                   TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <!-- Max -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="72"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Maks:" Grid.Column="0" FontSize="13" Foreground="#555"
                                   VerticalAlignment="Center"/>
                        <Slider x:Name="MaxMsSlider" Grid.Column="1"
                                Minimum="100" Maximum="10000" Value="3000"
                                TickFrequency="100" IsSnapToTickEnabled="True"
                                SmallChange="100" LargeChange="500"
                                ValueChanged="MaxMsSlider_ValueChanged" Margin="0,0,8,0"/>
                        <TextBlock x:Name="MaxMsLabel" Grid.Column="2" Text="3000 ms"
                                   FontSize="13" FontWeight="Bold" Foreground="#1565C0"
                                   TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Button Content="▶  Testi Başlat" Click="StartTest_Click"
                    Padding="20,12" FontSize="15" FontWeight="Bold"
                    Background="#1565C0" Foreground="White"
                    Cursor="Hand" Width="220" Height="52"
                    HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <Button Content="← Geri" Click="BackButton_Click"
                    Padding="15,8" FontSize="12"
                    Background="#666666" Foreground="White"
                    Cursor="Hand" Width="100" HorizontalAlignment="Center"/>

        </StackPanel>
    </ScrollViewer>
</Window>
