<Window x:Class="PsikologTestApp.Tests.DogruHedef.DogruHedefWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Doğru Hedef Testi" Height="660" Width="720"
        MinWidth="420" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#ECEFF1"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="66"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- Üst bilgi çubuğu -->
        <Border Grid.Row="0" Background="#1565C0">
            <Grid Margin="24,0">

                <!-- Sol: hedef hayvan -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="Hedef: " FontSize="14" Foreground="#B3E5FC" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TargetEmojiLabel" Text="🐱" FontSize="30"
                               VerticalAlignment="Center" Margin="4,0,6,0"/>
                    <TextBlock x:Name="TargetNameLabel"  Text="Kedi" FontSize="16" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="🎯 Doğru Hedef" FontSize="20" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Sağ: sayaçlar + zamanlayıcı -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="✅ " FontSize="13" Foreground="#B3E5FC" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HitBlock"   Text="0" FontSize="18" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBlock Text="❌ " FontSize="13" Foreground="#FFCDD2" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FalseBlock" Text="0" FontSize="18" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <TextBlock Text="⏱ " FontSize="14" Foreground="#B3E5FC" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TimerBlock" Text="05:00" FontSize="22" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Button Content="⏹ Bitir" Click="EndTestButton_Click"
                            Padding="10,4" FontSize="13" FontWeight="Bold"
                            Background="#E53935" Foreground="White"
                            Cursor="Hand" Height="36" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Uyaran alanı -->
        <Grid Grid.Row="1" Background="#ECEFF1">

            <!-- Boşluk sabitleyici noktası -->
            <TextBlock x:Name="FixationCross" Text="+" FontSize="52" FontWeight="Light"
                       Foreground="#BDBDBD"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"/>

            <!-- Hayvan kartı -->
            <Border x:Name="AnimalDisplayCard"
                    MaxWidth="340" MaxHeight="340" CornerRadius="22"
                    Background="White" BorderBrush="#E0E0E0" BorderThickness="3"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed">
                <TextBlock x:Name="StimulusEmojiBlock" Text="🐱" FontSize="190"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="24"/>
            </Border>

            <!-- Görünme süresi etiketi -->
            <TextBlock x:Name="DurationMsBlock"
                       FontSize="15" FontWeight="Bold" Foreground="#78909C"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       Margin="0,0,0,16"
                       Visibility="Collapsed"/>
        </Grid>

        <!-- Alt yönerge çubuğu -->
        <Border Grid.Row="2" Background="White" BorderBrush="#CFD8DC" BorderThickness="0,1,0,0">
            <TextBlock x:Name="InstructionBlock"
                       Text="SPACE — Hedef hayvanı gördüğünde bas"
                       FontSize="16" FontWeight="Bold" Foreground="#546E7A"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- Geri sayım overlay -->
        <Grid x:Name="CountdownOverlay" Grid.RowSpan="3"
              Background="#F01565C0" Panel.ZIndex="10">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="CountdownNumber" Text="3" FontSize="200" FontWeight="Black"
                           Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,-20"/>
                <TextBlock Text="Hazırın mı?" FontSize="28" Foreground="#B3E5FC"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Duraklat overlay -->
        <Grid x:Name="PauseOverlay" Grid.RowSpan="3"
              Background="#CC000000" Panel.ZIndex="20" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⏸ Test Duraklatıldı" FontSize="36" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="▶ Devam Et"   Click="ResumeButton_Click"
                            Padding="20,12" FontSize="16" FontWeight="Bold"
                            Background="#43A047" Foreground="White"
                            Cursor="Hand" Width="180" Height="52" Margin="0,0,20,0"/>
                    <Button Content="⏹ Testi Bitir" Click="EndTestButton_Click"
                            Padding="20,12" FontSize="16" FontWeight="Bold"
                            Background="#E53935" Foreground="White"
                            Cursor="Hand" Width="180" Height="52"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
